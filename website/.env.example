# Template only — copy to .env.local and fill in real values.
# .env.local is gitignored. Never commit real credentials.
#
# For deployed environments these live in SST secrets, not in a file:
#   npx sst secret set MeleeClientId "..." --stage production
#   npx sst secret set MeleeClientSecret "..." --stage production
#   npx sst secret list --stage production

# melee.gg tournament data API (org credentials from contact@melee.gg).
# Used as HTTP Basic auth — the ID is the username, the secret is the password.
MELEE_CLIENT_ID=
MELEE_CLIENT_SECRET=

# Discord OAuth (Stage 1). Local values from the Discord app's OAuth2 tab.
# Deployed values are SST secrets: DiscordClientId, DiscordClientSecret,
# AuthSecret, AdminDiscordIds.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# npx auth secret, or: openssl rand -base64 33
AUTH_SECRET=
# Comma-separated Discord user IDs allowed into /admin
ADMIN_DISCORD_IDS=

# YouTube channel for the content feed (RSS, no API key needed)
YOUTUBE_CHANNEL_ID=
