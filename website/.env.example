# Template only — copy to .env.local and fill in real values.
# .env.local is gitignored. Never commit real credentials.
#
# For deployed environments these live in SST secrets, not in a file:
#   npx sst secret set MeleeClientId "..." --stage production
#   npx sst secret set MeleeClientSecret "..." --stage production
#   npx sst secret list --stage production

# melee.gg tournament data API (org credentials from contact@melee.gg).
# Used as HTTP Basic auth — the ID is the username, the secret is the password.
MELEE_CLIENT_ID=
MELEE_CLIENT_SECRET=

# Discord OAuth (Stage 1). These live ONLY as SST secrets (DiscordClientId,
# DiscordClientSecret, AuthSecret, AdminDiscordIds), never in this file.
# src/lib/auth.ts reads Resource.* directly, and npm run dev wraps sst shell,
# so local dev picks them up from the deployed secrets automatically.

# Pod Discord webhook (Stage 2). Lives ONLY as SST secret (PodsWebhookUrl);
# read via Resource.PodsWebhookUrl.

# YouTube channel for the content feed (RSS, no API key needed)
YOUTUBE_CHANNEL_ID=

# Domain deploys (ADR 0003). These live in website/.env (not .env.local):
# sst deploy auto-loads .env, and the Cloudflare token is needed for every
# deploy once the domain block is in sst.config.ts.
# CLOUDFLARE_API_TOKEN=   (scoped to Edit zone DNS on bluemilkgaming.com)
# CLOUDFLARE_DEFAULT_ACCOUNT_ID=
